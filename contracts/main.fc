#include "imports/stdlib.fc";

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);

  slice sender_address = cs~load_msg_addr();
  int opcode = in_msg_body~load_uint(32);

  if (opcode == 1) {
    int increment_by = in_msg_body~load_uint(32);
    slice ds = get_data().begin_parse();
    int current_counter = ds~load_uint(32);

    set_data(begin_cell().store_uint(current_counter + increment_by, 32).store_slice(sender_address).end_cell());
  }
}

(int, slice) get_contract_storage_data() method_id {
  slice ds = get_data().begin_parse();

  int calls_count = ds~load_uint(32);
  slice address = ds~load_msg_addr();
  
  return (calls_count, address);
}